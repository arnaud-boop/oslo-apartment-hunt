<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title>Oslo apartments — {{ run_date }}</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

<header class="page-header">
  <h1>Oslo apartments</h1>
  <p class="meta">
    Daily digest ·
    <time datetime="{{ run_iso }}">{{ run_human }}</time>
    · {{ kept_count }} listings ranked of {{ scraped_count }} scraped
    ({{ dropped_count }} excluded by hard filters)
  </p>
  <details class="caveats">
    <summary>v1 scoring caveats — please read</summary>
    <ul>
      <li><strong>Hard filters applied:</strong> total ≤ 15M NOK, felleskostnader ≤ 7k/mo, area ≥ 90 m², ≥ 3 BR, no "oppussingsobjekt" in title, school proximity (≤ 25 min proxy to current OR next school, OR ≤ 30 min to both — non-negotiable).</li>
      <li><strong>Active sub-scores:</strong> wife's commute (real public-transit time via Entur, falling back to a Haversine proxy if the API is unreachable) and price/m² vs neighborhood median (K=15 nearest similar listings; full 0-100 range now that suburb bias is fixed).</li>
      <li><strong>Deferred to v1.0.5+:</strong> the apartment bucket (light, peis, ceiling, …), the building bucket, layout dealbreakers, sold/under-offer status, floor, bod, washing machine, real Entur transit times, neighborhood-aware pricing.</li>
      <li>Each card shows ⚠️ for unverified hard filters. Click the Finn link to verify before getting excited.</li>
    </ul>
  </details>
</header>

<main class="listings">
  {% for s in scored %}
  {% set l = s.listing %}
  <article class="listing-card" id="finn-{{ l.finn_id }}">
    <div class="card-photo">
      {% if l.image_url %}
        <img src="{{ l.image_url }}" alt="" loading="lazy">
      {% else %}
        <div class="no-photo">no photo</div>
      {% endif %}
    </div>

    <div class="card-body">
      <div class="card-header">
        <div class="score-badge {{ score_tier(s.score) }}">
          <span class="score-num">{{ '%.0f' % s.score }}</span>
          <span class="score-out-of">/100</span>
        </div>
        <div class="card-title-block">
          <h2><a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.title or '(no title)' }}</a></h2>
          <p class="card-address">
            {{ l.address or '' }}
            {%- if l.local_area %} · <span class="local-area">{{ l.local_area }}</span>{% endif %}
          </p>
          <p class="card-type">
            {{ l.property_type or '' }}{% if l.owner_type %} · {{ l.owner_type }}{% endif %}
          </p>
        </div>
      </div>

      <div class="card-stats">
        <div class="stat">
          <span class="stat-label">Total</span>
          <span class="stat-value">{{ fmt_nok(l.total_price) }}</span>
        </div>
        <div class="stat">
          <span class="stat-label">Ask</span>
          <span class="stat-value">{{ fmt_nok(l.asking_price) }}</span>
        </div>
        <div class="stat">
          <span class="stat-label">Felles/mnd</span>
          <span class="stat-value">{{ fmt_nok(l.fellesutgifter_month) }}</span>
        </div>
        <div class="stat">
          <span class="stat-label">Gjeld</span>
          <span class="stat-value">{{ fmt_nok(l.fellesgjeld) }}</span>
        </div>
        <div class="stat">
          <span class="stat-label">Area</span>
          <span class="stat-value">{{ l.area_m2 }} m²</span>
        </div>
        <div class="stat">
          <span class="stat-label">Beds</span>
          <span class="stat-value">{{ l.bedrooms }}</span>
        </div>
        {% if s.distance_to_current_home_km is not none %}
        <div class="stat">
          <span class="stat-label">From home</span>
          <span class="stat-value">{{ '%.1f' % s.distance_to_current_home_km }} km</span>
        </div>
        {% endif %}
      </div>

      {% if s.tags %}
      <div class="card-tags">
        {% for t in s.tags %}<span class="tag">{{ t }}</span>{% endfor %}
      </div>
      {% endif %}

      {% if s.sub_scores %}
      <div class="card-subscores">
        {% for sub in s.sub_scores %}
        <div class="subscore">
          <span class="subscore-name">{{ sub.name }}</span>
          <span class="subscore-bar">
            <span class="subscore-bar-fill" style="width: {{ sub.value }}%"></span>
          </span>
          <span class="subscore-value">{{ '%.0f' % sub.value }}</span>
          <span class="subscore-detail">{{ sub.detail }}</span>
        </div>
        {% endfor %}
      </div>
      {% endif %}

      {% if s.headline %}
      <p class="card-headline">{{ s.headline }}</p>
      {% endif %}

      {% if l.viewing_times %}
      <p class="card-visning">
        Visning:
        {% for v in l.viewing_times[:3] %}
          <time datetime="{{ v }}">{{ fmt_visning(v) }}</time>{% if not loop.last %}, {% endif %}
        {% endfor %}
        {% if l.viewing_times|length > 3 %} (+{{ l.viewing_times|length - 3 }} more){% endif %}
      </p>
      {% endif %}

      {% if s.details %}
      <details class="card-details" open>
        <summary>Computed details (proxy times, ±20%)</summary>
        <dl>
          {% for k, v in s.details.items() %}
          <dt>{{ k }}</dt><dd>{{ v }}</dd>
          {% endfor %}
        </dl>
      </details>
      {% endif %}

      {% if s.unverified %}
      <details class="card-unverified">
        <summary>⚠️ {{ s.unverified|length }} unverified — what we couldn't check</summary>
        <ul>
          {% for u in s.unverified %}<li>{{ u }}</li>{% endfor %}
        </ul>
      </details>
      {% endif %}

      <p class="card-link">
        <a href="{{ l.url }}" target="_blank" rel="noopener">→ View on Finn (#{{ l.finn_id }})</a>
      </p>
    </div>
  </article>
  {% endfor %}
</main>

<footer class="page-footer">
  <p>
    Generated {{ run_iso }} ·
    Personal use only ·
    <a href="https://github.com/arnaud-boop/oslo-apartment-hunt" target="_blank" rel="noopener">repo</a>
  </p>
</footer>

</body>
</html>
