<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title>Oslo apartments — {{ run_date }}</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

<header class="page-header">
  <h1>Oslo apartments</h1>
  <p class="meta">
    Daily digest ·
    <time datetime="{{ run_iso }}">{{ run_human }}</time>
    · {{ kept_count }} listings ranked of {{ scraped_count }} scraped
    ({{ dropped_count }} excluded by hard filters)
  </p>
  <details class="caveats">
    <summary>v1 scoring caveats — please read</summary>
    <ul>
      <li><strong>Hard filters applied:</strong> total ≤ 15M NOK, felleskostnader ≤ 7k/mo, area ≥ 90 m², ≥ 3 BR, no "oppussingsobjekt" in title, school proximity (≤ 25 min proxy to current OR next school, OR ≤ 30 min to both — non-negotiable).</li>
      <li><strong>Active sub-scores:</strong> wife's commute (real public-transit time via Entur, with Haversine fallback), price/m² vs neighborhood median (K=15 nearest similar listings, full 0-100 range), apartment bucket (LLM-detected light/orientation/ceiling/peis/bathtub/renovation/etc. + Finn facilities), and building bucket (family-friendly + quiet vs. busy street).</li>
      <li><strong>LLM-detected facts</strong> on each card show what Claude pulled from the description. Hover/tap the confidence percentage if shown — low-confidence judgments shouldn't be over-trusted.</li>
      <li><strong>Layout dealbreakers</strong> (long hallways, gjennomgangsrom, kitchen no window, bath off kitchen) are an LLM-driven hard filter that fires only when confidence ≥ 0.7. Listings dropped for this reason are gone from the digest entirely.</li>
      <li>Each card shows ⚠️ for unverified hard filters. Click the Finn link to verify before getting excited.</li>
    </ul>
  </details>
</header>

<main class="listings">
  {% for s in scored %}
  {% set l = s.listing %}
  <article class="listing-card" id="finn-{{ l.finn_id }}" data-finn-id="{{ l.finn_id }}">
    <div class="card-photo">
      {% if l.image_url %}
        <img src="{{ l.image_url }}" alt="" loading="lazy">
      {% else %}
        <div class="no-photo">no photo</div>
      {% endif %}
    </div>

    <div class="card-body">
      <div class="card-header">
        <div class="score-badge {{ score_tier(s.score) }}">
          <span class="score-num">{{ '%.0f' % s.score }}</span>
          <span class="score-out-of">/100</span>
        </div>
        <div class="card-title-block">
          <h2><a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.title or '(no title)' }}</a></h2>
          <p class="card-address">
            {{ l.address or '' }}
            {%- if l.local_area %} · <span class="local-area">{{ l.local_area }}</span>{% endif %}
          </p>
          <p class="card-type">
            {{ l.property_type or '' }}{% if l.owner_type %} · {{ l.owner_type }}{% endif %}
          </p>
        </div>
      </div>

      <div class="card-stats">
        <div class="stat">
          <span class="stat-label">Total</span>
          <span class="stat-value">{{ fmt_nok(l.total_price) }}</span>
        </div>
        <div class="stat">
          <span class="stat-label">Ask</span>
          <span class="stat-value">{{ fmt_nok(l.asking_price) }}</span>
        </div>
        <div class="stat">
          <span class="stat-label">Felles/mnd</span>
          <span class="stat-value">{{ fmt_nok(l.fellesutgifter_month) }}</span>
        </div>
        <div class="stat">
          <span class="stat-label">Gjeld</span>
          <span class="stat-value">{{ fmt_nok(l.fellesgjeld) }}</span>
        </div>
        <div class="stat">
          <span class="stat-label">Area</span>
          <span class="stat-value">{{ l.area_m2 }} m²</span>
        </div>
        <div class="stat">
          <span class="stat-label">Beds</span>
          <span class="stat-value">{{ l.bedrooms }}</span>
        </div>
        {% if s.distance_to_current_home_km is not none %}
        <div class="stat">
          <span class="stat-label">From home</span>
          <span class="stat-value">{{ '%.1f' % s.distance_to_current_home_km }} km</span>
        </div>
        {% endif %}
      </div>

      {% if s.tags %}
      <div class="card-tags">
        {% for t in s.tags %}<span class="tag">{{ t }}</span>{% endfor %}
      </div>
      {% endif %}

      {% if s.sub_scores %}
      <div class="card-subscores">
        {% for sub in s.sub_scores %}
        <div class="subscore">
          <span class="subscore-name">{{ sub.name }}</span>
          <span class="subscore-bar">
            <span class="subscore-bar-fill" style="width: {{ sub.value }}%"></span>
          </span>
          <span class="subscore-value">{{ '%.0f' % sub.value }}</span>
          <span class="subscore-detail">{{ sub.detail }}</span>
        </div>
        {% endfor %}
      </div>
      {% endif %}

      {% if s.headline %}
      <p class="card-headline">{{ s.headline }}</p>
      {% endif %}

      {% set llm = l.llm if l.llm else None %}
      {% if llm %}
      <div class="card-llm-flags">
        {%- set flags = [] -%}
        {%- if llm.main_orientation in ('south','west') %}{% set _ = flags.append('☀️ ' + llm.main_orientation) %}{% endif -%}
        {%- if llm.ceiling_height_high %}{% set _ = flags.append('high ceilings') %}{% endif -%}
        {%- if llm.has_open_plan_kitchen %}{% set _ = flags.append('open-plan') %}{% endif -%}
        {%- if llm.has_bakgaard %}{% set _ = flags.append('bakgård/garden') %}{% endif -%}
        {%- if llm.has_bathtub %}{% set _ = flags.append('bathtub') %}{% endif -%}
        {%- if llm.renovated_within_5_years %}{% set _ = flags.append('renovated <5y') %}{% endif -%}
        {%- if llm.family_friendly %}{% set _ = flags.append('family-friendly') %}{% endif -%}
        {%- if llm.has_visavi == false %}{% set _ = flags.append('no vis-à-vis') %}{% endif -%}
        {%- if llm.layout_clean %}{% set _ = flags.append('clean layout') %}{% endif -%}
        {%- if llm.heating_type == 'collective' %}{% set _ = flags.append('collective heat') %}{% endif -%}
        {%- if llm.on_busy_street %}{% set _ = flags.append('⚠️ busy street') %}{% endif -%}
        {%- if llm.has_visavi %}{% set _ = flags.append('⚠️ vis-à-vis') %}{% endif -%}
        {% for flag in flags %}<span class="llm-flag">{{ flag }}</span>{% endfor %}
        {% if llm.confidence is defined %}
          <span class="llm-confidence" title="LLM analysis confidence">conf {{ '%.0f' % (llm.confidence * 100) }}%</span>
        {% endif %}
      </div>
      {% endif %}

      {% if l.viewing_times %}
      <p class="card-visning">
        Visning:
        {% for v in l.viewing_times[:3] %}
          <time datetime="{{ v }}">{{ fmt_visning(v) }}</time>{% if not loop.last %}, {% endif %}
        {% endfor %}
        {% if l.viewing_times|length > 3 %} (+{{ l.viewing_times|length - 3 }} more){% endif %}
      </p>
      {% endif %}

      {% if s.details %}
      <details class="card-details" open>
        <summary>Computed details (proxy times, ±20%)</summary>
        <dl>
          {% for k, v in s.details.items() %}
          <dt>{{ k }}</dt><dd>{{ v }}</dd>
          {% endfor %}
        </dl>
      </details>
      {% endif %}

      {% if s.unverified %}
      <details class="card-unverified">
        <summary>⚠️ {{ s.unverified|length }} unverified — what we couldn't check</summary>
        <ul>
          {% for u in s.unverified %}<li>{{ u }}</li>{% endfor %}
        </ul>
      </details>
      {% endif %}

      {% set vote_state = votes.get(l.finn_id) if votes else None %}
      <div class="voting-block" data-finn-id="{{ l.finn_id }}">
        {% for v in ('arnaud', 'celine') %}
          {% set vstate = (vote_state.get(v) if vote_state else {}) or {} %}
          <div class="vote-column" data-voter="{{ v }}">
            <span class="vote-label">{{ 'Arnaud' if v == 'arnaud' else 'Céline' }}</span>
            <button class="vote-btn{% if vstate.vote == 'up'   %} active{% endif %}"
                    data-vote-button="up"   data-voter="{{ v }}">👍</button>
            <button class="vote-btn{% if vstate.vote == 'down' %} active{% endif %}"
                    data-vote-button="down" data-voter="{{ v }}">👎</button>
            <button class="vote-btn note-btn" data-note-toggle data-voter="{{ v }}">💬</button>
            <span class="note-display{% if not vstate.note %} empty{% endif %}">{{ vstate.note or '' }}</span>
          </div>
        {% endfor %}
        <div class="note-editor">
          {% set my_note = (vote_state.get('arnaud') or {}).get('note', '') if vote_state else '' %}
          <textarea data-note-input rows="2" placeholder="Add a note...">{{ my_note }}</textarea>
          <div class="note-editor-actions">
            <button data-note-save  class="note-action-btn save">Save</button>
            <button data-note-cancel class="note-action-btn cancel">Cancel</button>
          </div>
        </div>
        <span class="vote-status" aria-live="polite"></span>
      </div>

      <p class="card-link">
        <a href="{{ l.url }}" target="_blank" rel="noopener">→ View on Finn (#{{ l.finn_id }})</a>
      </p>
    </div>
  </article>
  {% endfor %}
</main>

<footer class="page-footer">
  <p>
    Generated {{ run_iso }} ·
    Personal use only ·
    <a href="https://github.com/arnaud-boop/oslo-apartment-hunt" target="_blank" rel="noopener">repo</a>
  </p>
</footer>

<script>
  window.VOTING_ENDPOINT = {{ voting_endpoint | tojson }};
</script>
<script src="votes.js" defer></script>

</body>
</html>
